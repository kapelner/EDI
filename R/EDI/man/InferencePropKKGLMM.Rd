\subsection{\code{InferencePropKKGLMM$new()}}{
  Initialize inference for the combined conditional-logit
  (discordant matched pairs) plus random-intercept-GLMM (concordant
  pairs/reservoir) proportion model; see
  \code{\link[EDI:InferencePropKKGLMM]{InferencePropKKGLMM}} for the model
  form. Does not fit the model; the fit is deferred to the first call to
  \code{compute_estimate()} or a method that requires it.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{InferencePropKKGLMM$new(
  des_obj,
  model_formula = NULL,
  max_abs_reasonable_coef = 10000,
  max_abs_log_sigma = 8,
  verbose = FALSE,
  smart_cold_start_default = NULL,
  optimization_alg = NULL
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{des_obj}}{A completed \code{Design} object with a proportion response.}
      \item{\code{model_formula}}{Optional formula for covariate adjustment.}
      \item{\code{max_abs_reasonable_coef}}{Cap for reasonable coefficient estimates.}
      \item{\code{max_abs_log_sigma}}{Cap for reasonable log random effect variance.}
      \item{\code{verbose}}{Whether to print progress messages.}
      \item{\code{smart_cold_start_default}}{Whether to use smart cold start values.}
      \item{\code{optimization_alg}}{Character. Optimization algorithm (default "lbfgs").}
    }
    \if{html}{\out{</div>}}
  }
