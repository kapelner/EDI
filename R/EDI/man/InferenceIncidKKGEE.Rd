\donttest{
for (i in 1:30) {
  seq_des$add_one_subject_to_experiment_and_assign(data.frame(x1 = rnorm(1), x2 = rnorm(1)))
}
seq_des$add_all_subject_responses(rbinom(30, 1, 0.5))
inf = InferenceIncidKKGEE$new(seq_des)
inf$compute_estimate()
}
