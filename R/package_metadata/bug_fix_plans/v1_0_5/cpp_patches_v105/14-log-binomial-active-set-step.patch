+// TODO-128 (v1.0.5 patch 14): active-set projection of the IRLS increment.
+// Rows whose linear predictor already sits within kActiveMargin of the
+// mean-support boundary (eta -> 0 for the log link; 0 or 1 for the identity
+// link) and whose unconstrained increment would push them further out are
+// held fixed: the increment d is replaced by the XtWX-metric projection of d
+// onto { d' : X_A d' = 0 }, i.e. d - H^{-1} X_A' (X_A H^{-1} X_A')^+ X_A d.
+// Without it the step-halving line search shrinks an outward step to ~1e-8,
+// the tiny accepted step passes the relative-change test, and the fit reports
+// converged = TRUE at (or near) its start: warm-started refits from a
+// boundary full-data fit returned the full-data estimate unchanged. Rows with
+// zero observation weight never constrain (they are absent from the
+// likelihood). Interior fits never form an active set, so they are unchanged.
+constexpr double kActiveMargin = 1e-6;
+
+inline Eigen::VectorXd project_increment_off_active_bounds(const Eigen::LDLT<Eigen::MatrixXd>& ldlt,
+                                                           const Eigen::MatrixXd& X_free,
+                                                           const Eigen::VectorXd& eta,
+                                                           const Eigen::VectorXd& d,
+                                                           BinomialConstrainedLink link_type,
+                                                           const Eigen::VectorXd* obs_weights = nullptr) {
+  const Eigen::VectorXd delta_eta = X_free * d;
+  std::vector<int> active;
+  for (int i = 0; i < (int)eta.size(); ++i) {
+    if (obs_weights != nullptr && !((*obs_weights)[i] > 0.0)) continue;
+    bool outward = false;
+    if (link_type == BinomialConstrainedLink::kLog) {
+      outward = eta[i] >= kMaxEtaLog - kActiveMargin && delta_eta[i] > 0.0;
+    } else {
+      outward = (eta[i] >= kMaxMu - kActiveMargin && delta_eta[i] > 0.0) ||
+                (eta[i] <= kMinMu + kActiveMargin && delta_eta[i] < 0.0);
+    }
+    if (outward) active.push_back(i);
+  }
+  if (active.empty()) return d;
+  const int p_free = (int)X_free.cols();
+  Eigen::MatrixXd XA((int)active.size(), p_free);
+  for (int k = 0; k < (int)active.size(); ++k) XA.row(k) = X_free.row(active[k]);
+  const Eigen::MatrixXd HinvXAt = ldlt.solve(XA.transpose());
+  const Eigen::MatrixXd S = XA * HinvXAt;
+  const Eigen::VectorXd lambda = S.completeOrthogonalDecomposition().solve(XA * d);
+  Eigen::VectorXd d_proj = d - HinvXAt * lambda;
+  if (!all_finite_vec(d_proj)) return d;
+  return d_proj;
+}
+
+// TODO-128 step 2 (v1.0.5 patch 14, owner decision 2026-10-22): KKT convergence
+// gate. The log-likelihood is concave and the mean-support constraints are
+// linear in beta, so a point satisfying the KKT conditions is the constrained
+// MLE. At a point where some rows sit within kActiveMargin of a bound, the fit
+// is converged only if (i) the Newton-metric projected increment
+// d = H^{-1}(g - C' lambda) onto { d : C d = 0 } (C = the signed near-bound
+// rows of X_free, g = score, H = Fisher information) satisfies
+// |d| / (|beta_free| + 1e-10) <= kKktTolFactor * tol (the same scale as the
+// loop's relative-change test), and (ii) every multiplier lambda is
+// >= -kKktLambdaRelTol * max(1, max|lambda|), i.e. each held bound is
+// genuinely binding (the score points outward there). Otherwise the fit
+// reports converged = false (honest NA downstream). Points with no row near a
+// bound never reach the gate, so interior fits are bit-identical.
+constexpr double kKktTolFactor = 10.0;
+constexpr double kKktLambdaRelTol = 1e-3;
+
+struct BoundKktVerdict {
+  bool ok = true;
+  int n_active = 0;
+};
+
+// Rows within kActiveMargin of a mean-support bound (zero-weight rows excluded:
+// they are absent from the likelihood), signed +1 for an upper bound (log:
+// eta -> 0; identity: mu -> 1) and -1 for a lower bound (identity: mu -> 0).
+inline int collect_near_bound_rows(const Eigen::VectorXd& eta,
+                                   BinomialConstrainedLink link_type,
+                                   const Eigen::VectorXd* obs_weights = nullptr,
+                                   std::vector<int>* rows = nullptr,
+                                   std::vector<double>* signs = nullptr) {
+  int count = 0;
+  for (int i = 0; i < (int)eta.size(); ++i) {
+    if (obs_weights != nullptr && !((*obs_weights)[i] > 0.0)) continue;
+    double s = 0.0;
+    if (link_type == BinomialConstrainedLink::kLog) {
+      if (eta[i] >= kMaxEtaLog - kActiveMargin) s = 1.0;
+    } else if (eta[i] >= kMaxMu - kActiveMargin) {
+      s = 1.0;
+    } else if (eta[i] <= kMinMu + kActiveMargin) {
+      s = -1.0;
+    }
+    if (s == 0.0) continue;
+    ++count;
+    if (rows != nullptr) rows->push_back(i);
+    if (signs != nullptr) signs->push_back(s);
+  }
+  return count;
+}
+
+// KKT verdict at the current iterate, from this iteration's Fisher information
+// (ldlt) and unconstrained Fisher-scoring increment d0 = target - beta_free
+// (H d0 = g, so no extra likelihood or information evaluation is needed).
+inline BoundKktVerdict kkt_verdict_at_bounds(const Eigen::LDLT<Eigen::MatrixXd>& ldlt,
+                                             const Eigen::MatrixXd& X_free,
+                                             const Eigen::VectorXd& eta,
+                                             const Eigen::VectorXd& d0,
+                                             const Eigen::VectorXd& beta_free,
+                                             BinomialConstrainedLink link_type,
+                                             double tol,
+                                             const Eigen::VectorXd* obs_weights = nullptr) {
+  BoundKktVerdict out;
+  std::vector<int> rows;
+  std::vector<double> signs;
+  out.n_active = collect_near_bound_rows(eta, link_type, obs_weights, &rows, &signs);
+  if (out.n_active == 0) return out;
+  Eigen::MatrixXd C(out.n_active, (int)X_free.cols());
+  for (int k = 0; k < out.n_active; ++k) C.row(k) = signs[k] * X_free.row(rows[k]);
+  const Eigen::MatrixXd HinvCt = ldlt.solve(C.transpose());
+  const Eigen::MatrixXd S = C * HinvCt;
+  const Eigen::VectorXd lambda = S.completeOrthogonalDecomposition().solve(C * d0);
+  const Eigen::VectorXd d = d0 - HinvCt * lambda;
+  if (!all_finite_vec(lambda) || !all_finite_vec(d)) {
+    out.ok = false;
+    return out;
+  }
+  const double crit = d.norm() / (beta_free.norm() + 1e-10);
+  const double lambda_floor = -kKktLambdaRelTol * std::max(1.0, lambda.cwiseAbs().maxCoeff());
+  out.ok = (crit <= kKktTolFactor * tol) && (lambda.minCoeff() >= lambda_floor);
+  return out;
+}
+
