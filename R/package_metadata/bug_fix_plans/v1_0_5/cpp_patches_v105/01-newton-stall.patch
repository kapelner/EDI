+// TODO-123 (optimize_likelihood_newton_false_nonconvergence.md): accept a Newton
+// terminal state that stalled at (numerically) the optimum. The gradient is a
+// SUM over observations, so the absolute `tol` is not scale-free; tol * lambda_max(H)
+// is the gradient size that corresponds to a parameter error of ~tol
+// (|theta - theta*| ~ H^-1 g). 10x slack plus an absolute cap of 1e-4.
+// Returns false for any non-finite quantity, so true failures are never loosened.
+template <typename LikelihoodFunctor>
+inline bool newton_stalled_at_optimum(LikelihoodFunctor& fun,
+                                      const Eigen::VectorXd& params,
+                                      double gnorm,
+                                      double tol) {
+    if (!std::isfinite(gnorm)) return false;
+    Eigen::MatrixXd H = hessian_for_opt(fun, params);
+    if (!H.allFinite()) return false;
+    Eigen::SelfAdjointEigenSolver<Eigen::MatrixXd> es(
+        0.5 * (H + H.transpose()), Eigen::EigenvaluesOnly);
+    if (es.info() != Eigen::Success) return false;
+    const double lam_max = es.eigenvalues().cwiseAbs().maxCoeff();
+    if (!std::isfinite(lam_max)) return false;
+    return gnorm < std::min(1e-4, 10.0 * tol * std::max(1.0, lam_max));
+}
