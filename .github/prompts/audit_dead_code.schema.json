{
  "type": "object",
  "required": [
    "units_checked",
    "findings"
  ],
  "properties": {
    "units_checked": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ids of every candidate you reached a verdict on"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "unit",
          "kind",
          "text",
          "evidence"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "description": "the candidate id from the batch file"
          },
          "kind": {
            "type": "string",
            "enum": [
              "confirmed",
              "false_positive",
              "unsure"
            ]
          },
          "text": {
            "type": "string",
            "description": "one or two sentences: what you searched, or the use you found"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "file:line references"
          }
        }
      }
    }
  }
}
