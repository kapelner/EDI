{
  "type": "object",
  "required": ["units_checked", "findings"],
  "properties": {
    "units_checked": {
      "type": "array",
      "items": {"type": "string"}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "kind", "text", "python_location", "r_location", "suggestion", "fix"],
        "properties": {
          "unit": {"type": "string", "description": "the unit id from the batch file"},
          "kind": {
            "type": "string",
            "enum": ["docstring", "default_mismatch", "argument_mismatch", "behaviour_mismatch",
                     "return_mismatch", "other"]
          },
          "text": {"type": "string", "description": "what disagrees, with both sides quoted"},
          "python_location": {"type": "string", "description": "file:line in python/"},
          "r_location": {"type": "string", "description": "file:line in R/EDI, or an empty string if not found"},
          "suggestion": {"type": "string", "description": "what to change and on which side"},
          "fix": {
            "type": "object",
            "required": ["file", "old_text", "new_text"],
            "properties": {
              "file": {"type": "string", "description": "for a docstring finding: the file under python/ to edit; else empty"},
              "old_text": {"type": "string", "description": "exact text in the file, occurring once, inside one docstring literal"},
              "new_text": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
