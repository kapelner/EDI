{
  "type": "object",
  "required": ["units_checked", "findings"],
  "properties": {
    "units_checked": {
      "type": "array",
      "items": {"type": "string"}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "kind", "text", "edi_files"],
        "properties": {
          "unit": {"type": "string"},
          "kind": {"type": "string", "enum": ["check", "nothing-to-check"]},
          "text": {"type": "string"},
          "edi_files": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
