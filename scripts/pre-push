#!/usr/bin/env bash
# Local pre-push gate: run the same checks CI would run, but only the ones
# relevant to what's actually changing, and skip the parts that duplicate
# work CI already does more thoroughly (--as-cran extras, multi-OS/ASAN/
# valgrind). The goal is to catch the common break-CI cases (a C++ syntax
# error, a failing test) before spending GitHub Actions minutes on them.
#
# Install with: git config core.hooksPath scripts
#
# Bypass for a single push (e.g. deliberate WIP): git push --no-verify
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Every Rscript below loads EDI, and each load prints this machine's saved
# tune_EDI_for_this_machine() notice ("...fastest at N cores ... call
# set_num_cores(N) to opt in"). Skipping the saved tuning silences it and runs
# the hook on shipped defaults, the same as CI, which has no saved tuning.
# Tests of the tuning import set this variable themselves (withr::local_envvar).
export EDI_SKIP_LOCAL_TUNING=1

zero_sha="0000000000000000000000000000000000000000"
empty_tree_sha="4b825dc642cb6eb9a060e54bf8d69288fbee4904"  # git's canonical empty-tree object, always valid
changed_files_file="$(mktemp)"
# On every exit (pass, fail or early skip), report how long the hook ran.
# SECONDS is bash's builtin count of seconds since the script started.
prepush_report_elapsed() {
	local status=$? s=$SECONDS verdict="passed"
	[[ $status -ne 0 ]] && verdict="FAILED (exit $status)"
	printf 'pre-push: %s after %02d:%02d:%02d elapsed.\n' "$verdict" $((s / 3600)) $((s % 3600 / 60)) $((s % 60)) >&2
	rm -f "$changed_files_file"
}
trap prepush_report_elapsed EXIT
roxygen_touched=0

# git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin,
# one per ref being pushed. Collect the union of files changed by each.
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero_sha" ] && continue  # deleting a remote ref -- nothing to check

	if [ "$remote_sha" = "$zero_sha" ]; then
		# New branch/ref on the remote: no remote_sha to diff against. Fall back to
		# the merge-base with main; if even that fails (e.g. no origin/main locally),
		# diff against the empty tree so every file in the pushed commit counts as
		# changed, rather than skipping checks.
		base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
		[ -z "$base" ] && base="$empty_tree_sha"
	else
		base="$remote_sha"
	fi

	git diff --name-only "$base" "$local_sha" >> "$changed_files_file"

	# Content-level check, not just "did the file change": most edits to an R
	# source file don't touch its roxygen comments at all, so gating on the
	# file list alone would run fast_roxygenize.R far more often than needed.
	# `#'` line additions/removals are roxygen doc-comment edits; an
	# `[[Rcpp::export]]` tag change affects Rcpp::compileAttributes()'s output
	# (also run by fast_roxygenize.R), so it counts too.
	# Not `| grep -q`: under `set -o pipefail`, grep -q exits at the first match,
	# git diff then dies of SIGPIPE (status 141) on any diff larger than the pipe
	# buffer, and the failed pipeline reads as "no roxygen change". That silently
	# skipped fast_roxygenize.R on a 495-line roxygen diff (2026-11-10). Count
	# instead, so grep reads all of its input.
	roxy_lines="$(git diff -U0 "$base" "$local_sha" -- 'R/EDI/R/*.R' 'R/EDI/src/*.cpp' 2>/dev/null \
		| grep -cE "^[+-]#'|^[+-].*\[\[Rcpp::export" || true)"
	if [ "${roxy_lines:-0}" -gt 0 ]; then
		roxygen_touched=1
	fi
done

sort -u "$changed_files_file" -o "$changed_files_file"

if [ ! -s "$changed_files_file" ]; then
	echo "pre-push: no file changes detected relative to the remote, skipping local checks."
	exit 0
fi

echo "pre-push: files changed since remote:"
sed 's/^/  /' "$changed_files_file"
echo

# R-CMD-check.yaml's path filter (R/EDI/**/*.{R,Rd,cpp,h,hpp}, DESCRIPTION,
# NAMESPACE, configure(.win), src/Makevars(.win)) minus .Rd: no R test and no
# R/package_tests script reads man/, so an Rd-only push skips the R and
# comprehensive suites and gets the CRAN static checks below instead, which do
# read the Rd files (examples, usage). CI still checks every Rd (2026-11-14).
run_r_tests=0
if grep -qE '^R/EDI/(.*\.(R|cpp|h|hpp)|DESCRIPTION|NAMESPACE|configure|configure\.win|src/Makevars|src/Makevars\.win)$' "$changed_files_file"; then
	run_r_tests=1
fi
r_docs_changed=0
if grep -qE '^R/EDI/.*\.Rd$' "$changed_files_file"; then
	r_docs_changed=1
fi

# The python package's code, tests and build config (not its docs, CHANGELOG
# or benchmarks, which no test reads; 2026-11-14) plus R/EDI/src/**/*.{cpp,h,hpp}
# -- R/EDI/src is the single source of
# truth the Python C++ extension compiles directly (see python/CMakeLists.txt),
# so a kernel change affects both sides. This is the set of changes that can
# break the python suite; test-coverage-python.yml itself now runs on EVERY
# pull request (no path filter, 2026-10-15) so that every PR produces at least
# one Codecov upload, but locally there is no reason to rebuild the extension
# for a change that cannot have touched it.
run_python_tests=0
if grep -qE '^python/(src|tests|cpp)/|^python/(CMakeLists\.txt|pyproject\.toml)$|^R/EDI/src/.*\.(cpp|h|hpp)$' "$changed_files_file"; then
	run_python_tests=1
fi

# Mirrors test-coverage-R-advanced.yml's path filter: anything that would trigger
# run_r_tests above, plus R/package_tests/** itself and the one doc file the
# workflow also watches.
run_comprehensive_suite=0
# Except R/package_tests/calibration/ and R/package_tests/ci/: no drift generator
# (drift_artifacts.sh) and no smoke-tier case reads them, so a push touching only
# those skips this ~15-min step. CI's path filter stays broad.
# Counted, not `| grep -q`: under pipefail an early-exiting grep -q can SIGPIPE
# the first grep and read as "no match" (see the roxygen check above).
suite_inputs_changed="$(grep -E '^R/package_tests/|^R/package_metadata/finished_features/v1_0_0/comprehensive_test_suite\.md$' "$changed_files_file" \
	| grep -cvE '^R/package_tests/(calibration|ci)/' || true)"
if [ "$run_r_tests" = "1" ] || [ "${suite_inputs_changed:-0}" -gt 0 ]; then
	run_comprehensive_suite=1
fi

# Fail fast: the first failing check aborts the push immediately -- later
# checks are not run, so control returns to the terminal right away instead
# of grinding through the remaining (potentially slow) blocks first.
abort_push() {
	echo "pre-push: a local check failed -- stopping remaining checks; push aborted." >&2
	echo "pre-push: fix the failure, or bypass with 'git push --no-verify' if you really mean to push anyway." >&2
	exit 1
}

# Keep the CI runtime manifest in sync with the actual test-file inventory
# before anything downstream reads it (the shard-inventory check right
# below, and CI's own planners) -- this is exactly the fix the check-only
# failure message below tells a developer to run by hand; running it
# proactively here means routine "added/removed a test file" drift never
# needs a manual step at all. No compilation, no R -- pure Python file
# listing. Regenerates test_runtimes.csv in place; like fast_roxygenize.R's
# regeneration further down, this hook does not auto-commit the result (a
# hook-made commit can't be included in the push that's already resolving --
# see gitpush_with_hooks_safe.sh's header comment) -- review/include it in
# your next commit if `git status` shows it changed.
echo "pre-push: refreshing the CI test-runtime manifest ..."
if ! python3 R/package_tests/ci/refresh_manifest.py; then
	echo "pre-push: refresh_manifest.py FAILED (see output above)." >&2
	abort_push
fi

# Catch stale shard inventories before any builds or R checks. The planner
# only reads filenames and CSV estimates; it never loads R or writes files.
if grep -qE '^R/EDI/tests/testthat/|^R/package_tests/testthat_bulk/|^R/package_tests/ci/|^scripts/pre-push$|^\.github/workflows/test-(bulk-non-cran\.yml|coverage-R\.yaml)$' "$changed_files_file"; then
	echo "pre-push: checking R CI shard inventories and runtime budgets ..."
	if ! python3 R/package_tests/ci/plan_shards.py correctness --check-only \
		|| ! python3 R/package_tests/ci/plan_shards.py coverage --check-only; then
		echo "pre-push: shard check FAILED. For inventory drift, run 'python3 R/package_tests/ci/refresh_manifest.py' and commit R/package_tests/ci/test_runtimes.csv with the test changes. For oversized estimates, split the test or review its timing estimate." >&2
		abort_push
	fi
else
	echo "pre-push: no shard-relevant files changed, skipping shard inventory check."
fi

# Only the USER-FACING docs are link-checked (see check_doc_links.py's
# docstring): READMEs, python/CHANGELOG.md, R/EDI/REFERENCES.md, and the
# roxygen comments in R/EDI/R/*.R. Internal plan documents
# (R/package_metadata/**, etc.) are not checked, so changes to them don't
# trigger this. Still not narrowed to which links moved within that corpus,
# since a link can break from the OTHER end (renaming/moving the file it
# points at breaks every doc that links to the old path, none of which show
# up in a diff of the doc file itself).
run_doc_link_check=0
if grep -qE '(^|/)README(_PYPI)?\.md$|^python/CHANGELOG\.md$|^R/EDI/REFERENCES\.md$|^R/EDI/R/.*\.R$' "$changed_files_file"; then
	run_doc_link_check=1
fi

if [ "$run_doc_link_check" = "1" ]; then
	echo "pre-push: user-facing docs/roxygen changed -- checking documentation links ..."
	# Internal (relative-path) links block on new breakage only -- pre-existing
	# debt is tracked in scripts/check_doc_links_baseline.csv (regenerate via
	# --write-baseline) so this doesn't retroactively block every push on the
	# existing backlog. External HTTP failures block too; network failures
	# warn after retry, and automated-client refusals are filtered by the checker.
	if ! python3 scripts/check_doc_links.py; then
		echo "pre-push: documentation link check FAILED (see output above)." >&2
		abort_push
	fi
else
	echo "pre-push: no user-facing docs/roxygen changed, skipping documentation link check."
fi

echo

# README.md's lines-of-code badge is no longer generated/checked here at
# all -- it's a static badge (see README.md's "Lines of Code" section) that
# fetches live data from a Gist, kept fresh by .github/workflows/loc-badge.yml
# running server-side on every push to main. README.md itself never changes,
# so there's nothing for this hook to regenerate or warn about anymore. See
# scripts/generate_loc_badge_data.sh for the generator this replaced
# scripts/update_readme_cloc.sh with.

if [ "$roxygen_touched" = "1" ]; then
	# Run before fast_roxygenize.R: catches a citation-map drift (a renamed/
	# merged class REFERENCES.md still cites, or a new @references block that
	# never got indexed) independently of whether Rd regeneration itself
	# succeeds, and reports it with its own targeted message rather than
	# folding into fast_roxygenize.R's own warning output.
	echo "pre-push: roxygen comments changed -- checking @references/REFERENCES.md sync ..."
	if ! Rscript R/package_tests/check_references_sync.R; then
		echo "pre-push: @references/REFERENCES.md sync check FAILED (see output above)." >&2
		abort_push
	fi

	echo
	echo "pre-push: roxygen comments / [[Rcpp::export]] tags changed -- running fast_roxygenize.R ..."
	# fast_roxygenize.R regenerates R/EDI/man/*.Rd, R/EDI/NAMESPACE, and
	# R/EDI/R/RcppExports.R + R/EDI/src/RcppExports.cpp *in place* -- this is a
	# real side effect on the working tree, not just a check, and is the whole
	# point (stale generated docs/exports are exactly what this is meant to
	# catch). Runs before the install below so a changed Rcpp::export
	# signature gets a freshly regenerated RcppExports.cpp before compiling
	# against it, rather than compiling against a stale one.
	roxy_out="$(mktemp)"
	(cd R && Rscript fast_roxygenize.R) > "$roxy_out" 2>&1
	roxy_status=$?
	cat "$roxy_out"
	if [ "$roxy_status" != "0" ]; then
		echo "pre-push: fast_roxygenize.R FAILED (see output above)." >&2
		rm -f "$roxy_out"
		abort_push
	elif grep -qE "^Warning" "$roxy_out"; then
		# roxygenize() reports doc problems (undocumented R6 methods, etc.) as R
		# warnings, not errors -- Rscript still exits 0, so the exit code alone
		# can't catch these; the printed "Warning message(s):" block is the
		# only signal.
		echo "pre-push: fast_roxygenize.R reported a documentation warning (see output above)." >&2
		rm -f "$roxy_out"
		abort_push
	fi
	rm -f "$roxy_out"

	# fast_roxygenize.R regenerated the files below in place but does not commit
	# them. If they now differ from HEAD (or roxygen created new Rd files), the
	# commit being pushed carries stale docs/exports: stop and have them
	# committed, rather than auto-committing generated docs or exports
	# (2026-10-23).
	generated_paths=(R/EDI/man R/EDI/NAMESPACE R/EDI/R/RcppExports.R R/EDI/src/RcppExports.cpp)
	stale_generated="$(git diff --name-only HEAD -- "${generated_paths[@]}")"
	new_rd="$(git ls-files --others --exclude-standard -- R/EDI/man)"
	if [ -n "$stale_generated" ] || [ -n "$new_rd" ]; then
		echo "pre-push: regenerated docs/exports are not committed:" >&2
		[ -n "$stale_generated" ] && printf '  modified:  %s\n' $stale_generated >&2
		[ -n "$new_rd" ] && printf '  untracked: %s\n' $new_rd >&2
		echo "pre-push: commit them (e.g. 'git add R/EDI/man R/EDI/NAMESPACE R/EDI/R/RcppExports.R R/EDI/src/RcppExports.cpp && git commit') and push again." >&2
		abort_push
	fi
else
	echo "pre-push: no roxygen-relevant changes, skipping fast_roxygenize.R."
fi

echo

# The CRAN pre-submission static checks that scripts/
# submission_tar_build_and_win_mac_check.sh runs as its steps 1b-1d, run here
# too so a problem is caught at push time rather than at release time. All
# three need only the source tree (no install, no build), take a few seconds
# each, and run after fast_roxygenize.R above so they see the regenerated
# man/. Each came from a real CRAN rejection (2026-09-25):
#   - check_examples_for_cran.R --static-only: no \dontrun{}, all Rd example
#     code parses ("Unexecutable code in man/X.Rd");
#   - check_global_state_for_cran.R --static-only: no writes to .GlobalEnv, no
#     `<<-` that could reach it, no attach();
#   - check_rd_usage_for_cran.R: every Rd \usage argument documented.
# Any non-zero exit OR any R warning in their output fails the push.
run_cran_static_checks=0
if [ "$run_r_tests" = "1" ] || [ "$r_docs_changed" = "1" ] || grep -qE '^scripts/check_.*_for_cran\.R$|^scripts/pre-push$' "$changed_files_file"; then
	run_cran_static_checks=1
fi

if [ "$run_cran_static_checks" = "1" ]; then
	for cran_check in "check_examples_for_cran.R --static-only" "check_global_state_for_cran.R --static-only" "check_rd_usage_for_cran.R"; do
		cran_script="${cran_check%% *}"
		cran_flags=""
		[ "$cran_script" != "$cran_check" ] && cran_flags="${cran_check#* }"
		echo "pre-push: CRAN static check: $cran_script $cran_flags ..."
		cran_out="$(mktemp)"
		set +e
		# shellcheck disable=SC2086
		Rscript "scripts/$cran_script" R/EDI $cran_flags > "$cran_out" 2>&1
		cran_status=$?
		set -e
		cat "$cran_out"
		if [ "$cran_status" != "0" ]; then
			echo "pre-push: CRAN static check $cran_script FAILED (see output above)." >&2
			rm -f "$cran_out"
			abort_push
		elif grep -qE "^Warning" "$cran_out"; then
			# R warnings don't change Rscript's exit code; the printed
			# "Warning message(s):" block is the only signal.
			echo "pre-push: CRAN static check $cran_script emitted an R warning (see output above)." >&2
			rm -f "$cran_out"
			abort_push
		fi
		rm -f "$cran_out"
	done
else
	echo "pre-push: no R-package changes, skipping CRAN static checks."
fi

echo

# Only C++ sources or configure feed this check (it copies R/EDI/src/*.cpp,
# *.h and configure), so an .R/.Rd-only push skips it (2026-11-14).
if grep -qE '^R/EDI/(src/.*\.(cpp|h|hpp)|configure(\.win)?)$' "$changed_files_file"; then
	# Standing regression gate for package_metadata/new_feature_plans/
	# unity_build_collision_audit.md's fix: verifies every unity-build
	# wrapper (R/EDI/src/unity_NN.cpp, EDI_UNITY=1 -- the default) still
	# compiles cleanly, catching a *future* kernel file introducing a new
	# duplicated-symbol/repeated-default-argument collision. Runs in an
	# isolated scratch copy (see the script's own comment for why) --
	# independent of whether this working tree currently has EDI_UNITY=1 or
	# =0 configured, so it still catches a regression even when a developer
	# is deliberately running with EDI_UNITY=0 for fast targeted local
	# compiles. ~30-40s (10 translation units checked in parallel).
	echo "pre-push: C++-relevant files changed -- checking unity-build safety ..."
	if ! bash scripts/check_unity_build_safety.sh; then
		echo "pre-push: unity-build safety check FAILED (see output above)." >&2
		abort_push
	fi
else
	echo "pre-push: no C++-relevant changes, skipping unity-build safety check."
fi

echo

# One shared, in-place install for both R blocks below, instead of each doing
# its own. R CMD INSTALL compiles directly against R/EDI/src's existing *.o
# files (standard make-based incremental build -- unchanged *.cpp files are
# NOT recompiled), unlike R CMD build/check, which always extracts into a
# fresh, *.o-free tarball (verified: 0 of 856 packaged files) and therefore
# always forces a full from-scratch recompile regardless of what changed or
# where it runs. That trades away R CMD check's other sub-checks (Rd,
# NAMESPACE, DESCRIPTION fields, examples, packaging/.Rbuildignore
# correctness) -- those only mean anything against the real tarball
# round-trip, so they're left to CI's R-CMD-check.yaml (--as-cran), which
# already covers them authoritatively.
# Install only when the push changes what goes into the installed package:
# R/EDI/R, src, inst, data, DESCRIPTION, NAMESPACE, configure. Test files
# (R/EDI/tests, R/package_tests) are read from the checkout, not the install,
# and man/ is skipped by --no-help, so a push touching only those runs its
# checks against the EDI already installed (2026-11-14).
need_install=0
if grep -qE '^R/EDI/(R/|src/|inst/|data/|DESCRIPTION$|NAMESPACE$|configure(\.win)?$)' "$changed_files_file"; then
	need_install=1
fi

if [ "$need_install" = "1" ]; then
	echo "pre-push: installing EDI (incremental) ..."
	# This install is only ever used to run tests/scripts against, never as a
	# package someone actually loads and uses day-to-day -- skip everything
	# that doesn't affect whether the code runs correctly.
	if ! R CMD INSTALL --no-byte-compile --no-html --no-demo --no-help R/EDI; then
		echo "pre-push: EDI install FAILED." >&2
		abort_push
	fi
fi

echo

# Inference consistency check (the "consistency" block; named apart from the
# scheduled calibration study, which checks size and coverage) for the inference
# classes this push touched (R/package_tests/calibration/
# prepush_calibration_checks.R; design: R/package_metadata/new_feature_plans/
# v1_0_5/calibration_gates.md):
# per-replicate CI/test agreement, CI-endpoint inversion and a large-effect sign
# check on synthetic data. Deterministic (fixed seeds); size and coverage are
# left to the scheduled calibration-fast-tier workflow. Seconds for one class;
# a change to a base class or the registry selects every class (466 s in one
# process, 105 s as six, 2026-11-15), so it runs one process per response type, all at once,
# as its own block alongside the R suite. The response types share nothing: each
# process judges, and matches known failures for, only its own type.
# EDI_PREPUSH_CALIBRATION=skip skips it, =all checks every class.
consistency_response_types=(continuous incidence proportion count ordinal survival)
consistency_timeout_secs=900
run_consistency_block() {
	if [ "$run_r_tests" != "1" ]; then
		echo "pre-push: no R-relevant files changed, skipping the inference consistency check."
		return 0
	fi
	echo "pre-push: R-relevant files changed -- inference consistency check (CI/test agreement, CI endpoints, effect sign) for touched classes (${#consistency_response_types[@]} processes, one per response type) ..."
	local cal_dir="$block_log_dir/consistency" rt i status
	local -a pids=() failed=() timed_out=()
	mkdir -p "$cal_dir"
	for rt in "${consistency_response_types[@]}"; do
		timeout --foreground --kill-after=30s "${consistency_timeout_secs}s" \
			Rscript R/package_tests/calibration/prepush_calibration_checks.R \
			--changed-files "$changed_files_file" --response-types "$rt" > "$cal_dir/$rt.log" 2>&1 &
		pids+=($!)
	done
	for i in "${!pids[@]}"; do
		rt="${consistency_response_types[$i]}"
		status=0
		wait "${pids[$i]}" || status=$?
		if [ "$status" != 0 ]; then
			failed+=("$rt")
			if [ "$status" = 124 ] || [ "$status" = 137 ]; then timed_out+=("$rt"); fi
		fi
	done
	# One summary when nothing was touched, instead of six "nothing to check" lines.
	local touched=0
	for rt in "${consistency_response_types[@]}"; do
		if grep -q "nothing to check" "$cal_dir/$rt.log"; then continue; fi
		touched=1
		cat "$cal_dir/$rt.log"
	done
	if [ "$touched" = 0 ]; then echo "pre-push: no inference class touched -- no consistency check needed."; fi
	if [ "${#failed[@]}" -gt 0 ]; then
		if [ "${#timed_out[@]}" -gt 0 ]; then
			echo "pre-push: inference consistency check TIMED OUT after ${consistency_timeout_secs}s for: ${timed_out[*]}." >&2
		fi
		echo "pre-push: inference consistency check FAILED for: ${failed[*]} (details above). A known, triaged failure goes in R/package_tests/calibration/prepush_calibration_known_failures.csv." >&2
		abort_push
	fi
}

run_r_block() {
if [ "$run_r_tests" = "1" ]; then
	# Fast structural gate BEFORE the ~3-5 min suite below: (1) every
	# constructible inference class has the methods its component composition
	# and capability set promise, and every private$x() call resolves; (2) the
	# registry's hand-maintained component lists still match the real
	# define_inference_class(components=) calls. Together these catch the
	# "silently NULL method -> 'attempt to apply non-function'" bug family
	# (found 2026-09-19 by a raw comprehensive_tests results audit -- see the
	# header of test-inference-class-wiring-completeness.R). Also (3) pathological
	# data + injected SE faults must give a clean NA/error, never a wrong-looking
	# number, and (4) estimates/SEs must match survival/quantreg/pscl/glm/... on
	# fixed data. ~1.5 minutes. The full suite then skips these files
	# (EDI_PREPUSH_STRUCTURAL_PASSED below) rather than running them again.
	echo "pre-push: R-relevant files changed -- structural wiring/drift/adversarial/parity audit ..."
	if ! ( cd R/EDI/tests && NOT_CRAN=true Rscript "$repo_root/scripts/run_structural_checks.R" ); then
		echo "pre-push: structural wiring/drift/adversarial/parity audit FAILED (details above)." >&2
		echo "pre-push: an unlisted gap means a method/hook is missing on an assembled class; a drift means inference_class_registry.R disagrees with a define_inference_class() call." >&2
		abort_push
	fi
	# The full suite below skips these five files now that they passed
	# (scripts/structural_check_files.R lists them), instead of running them twice.
	export EDI_PREPUSH_STRUCTURAL_PASSED=1
	echo
fi

if [ "$run_r_tests" = "1" ]; then
	echo "pre-push: R-relevant files changed -- running R's test suite ..."
	# Same script + NOT_CRAN gate R CMD check's own "checking tests" phase
	# runs internally, just invoked directly against the already-installed
	# package instead of paying for a second, tarball-forced full recompile.
	# Must run with cwd = R/EDI/tests: test_check() calls
	# test_dir("testthat", ...) with a path relative to the CURRENT WORKING
	# DIRECTORY, not the script's location -- R CMD check gets away with a
	# bare "testthat" because it copies testthat.R into tests/ and runs it
	# from there. Running from the repo root instead makes "testthat"
	# resolve to a nonexistent ./testthat, and test_dir() silently reports
	# "No test files found." rather than erroring.
	# Uses scripts/run_prepush_r_tests.R rather than R/EDI/tests/testthat.R
	# directly: that script's default CheckReporter prints one line per
	# test file (and, on a failing expectation, testthat >=3.3.2's
	# extract_test() additionally writes a slow tests/testthat/_problems/*.R
	# reprex for EVERY failing expectation -- on a genuinely failing test
	# with many failing expectations that's enough slow work to stall this
	# hook long enough for git's already-open connection to the remote
	# (opened for ref negotiation before this hook even runs) to go idle
	# and get dropped: "Connection to github.com closed by remote host.").
	# run_prepush_r_tests.R instead uses its own reporter that just tallies
	# pass/fail/warn/skip counts into a fixed, live-updating 4-line block --
	# it never calls extract_test(), so no _problems/ writes happen either
	# way. Must run with cwd = R/EDI/tests: test_dir("testthat", ...) inside
	# that script is relative to the CWD, same as test_check()'s internal
	# call -- R CMD check gets away with a bare "testthat" because it
	# copies testthat.R into tests/ and runs it from there.
	#
	# Wrapped in `timeout`: a genuine hang in the suite (seen in practice --
	# a parallel-worker test stalled for hours, eventually dropping git's
	# already-open connection to the remote: "Connection to github.com
	# closed by remote host.") would otherwise block this hook, and the
	# push, indefinitely. A normal full run takes ~3-5 minutes in parallel lanes
	# (~8 in one process, EDI_PREPUSH_TEST_WORKERS=1); 20 gives
	# comfortable headroom without turning a real hang into another
	# multi-hour wait. --kill-after=30s escalates to SIGKILL if the process
	# (or an orphaned parallel worker under it) ignores the initial SIGTERM.
	#
	# --foreground: without it, `timeout` puts Rscript in its own process
	# group so it can reliably kill the whole subtree via --kill-after --
	# but that also means the terminal's Ctrl+C (SIGINT, delivered to the
	# foreground process *group*) never reaches Rscript at all, only
	# `timeout` itself (confirmed in practice: repeated Ctrl+C during a
	# local push did nothing, the suite kept running regardless).
	# --foreground keeps Rscript in the same group so it gets TTY signals
	# directly. Its tradeoff ("children of COMMAND will not be timed out")
	# is why EDI_PREPUSH_NO_PARALLEL defaults to true below: with real
	# multi-core/mirai worker tests skipped for this run (see
	# helper-prepush-no-parallel.R), there generally are no orphaned worker
	# children left for --kill-after to need to clean up in the first place.
	# Defaults to true rather than hardcoding it, so a developer can opt
	# back into running those tests for one push with
	# `EDI_PREPUSH_NO_PARALLEL=false git push` -- every test gated by
	# helper-prepush-no-parallel.R already carries its own skip_on_cran()
	# too, so this is purely a local convenience knob, not the only place
	# that coverage exists (see that helper's header comment).
	r_test_timeout_secs=1200
	run_r_suite() {
		( cd R/EDI/tests && NOT_CRAN=true EDI_PREPUSH_NO_PARALLEL="${EDI_PREPUSH_NO_PARALLEL:-true}" timeout --foreground --kill-after=30s "${r_test_timeout_secs}s" Rscript "$repo_root/scripts/run_prepush_r_tests.R" )
	}
	# Parallel mode: the suite gets its own log, since run_prepush_r_tests.R
	# reopens /dev/stderr for its tally and that would truncate this block's
	# shared log (see run_parallel_blocks). Its non-tty progress lines (one
	# every ~5 s) are dropped when the log is printed; the hook's heartbeat
	# covers progress. EDI_PREPUSH_SERIAL=1 keeps the live display.
	show_r_suite_log() {
		[ -n "${r_suite_log:-}" ] || return 0
		tr '\r' '\n' < "$r_suite_log" | grep -v '^EDI R test suite -- running' | grep -v '^[[:space:]]*$' || true
	}
	r_suite_log=""
	if [ "${EDI_PREPUSH_SERIAL:-0}" != "1" ]; then r_suite_log="$block_log_dir/r_suite.log"; fi
	if if [ -n "$r_suite_log" ]; then run_r_suite > "$r_suite_log" 2>&1; else run_r_suite; fi; then
		show_r_suite_log
	else
		r_test_exit=$?
		show_r_suite_log
		if [ "$r_test_exit" = "124" ] || [ "$r_test_exit" = "137" ]; then
			echo "pre-push: R tests TIMED OUT after ${r_test_timeout_secs}s -- this is a hang, not a slow-but-real run (normal full runs take ~3-5 min, ~8 in one process)." >&2
			echo "pre-push: see R/EDI/tests/.prepush_test_stdout.log for whatever the suite printed before it was killed." >&2
		else
			echo "pre-push: R tests FAILED -- see R/EDI/tests/.prepush_errors for failure/warning/skip detail." >&2
		fi
		abort_push
	fi
else
	echo "pre-push: no R-relevant files changed, skipping R checks."
fi
}

run_comprehensive_block() {
if [ "$run_comprehensive_suite" = "1" ]; then
	echo "pre-push: R/package_tests-relevant files changed -- running comprehensive suite (smoke tier) + drift check ..."

	# Generated-CSV drift is almost always cosmetic (e.g. a source line-number
	# column shifting because an unrelated edit added/removed lines elsewhere
	# in the same file) -- the generators are deterministic given a fixed
	# source tree, so the "fix" is never anything other than "regenerate and
	# commit". Self-heal it here instead of making that a manual step every
	# time: regenerate, and if the regenerated CSVs differ from what's
	# committed, stage+commit them and check again.
	#
	# More than one attempt is routinely needed for a reason that has
	# nothing to do with generator determinism: this repo is often being
	# edited by other concurrent sessions/processes while the hook runs (the
	# generator suite takes real wall-clock time). A source file can change
	# mid-run, so attempt 1's regeneration is already stale by the time it
	# finishes and attempt 2 (or 3) is what actually catches up and
	# converges -- confirmed 2026-08-26 when a second attempt's fix commit
	# picked up a live `run_all_inference()` signature change (17 -> 18
	# args) that landed between attempts. The bounded retry count exists so
	# a *genuinely* non-deterministic generator (same source tree, different
	# output on consecutive runs) still fails loudly instead of looping
	# forever -- that would be a real bug to fix in the generator, not
	# something to paper over indefinitely. It is not a guarantee against
	# the concurrent-edit case above: if edits keep landing for the entire
	# duration of every attempt, no finite count converges, and the normal
	# "push again" fallback below is the actual answer.
	# The generator sequence and this artifact list live in ONE place,
	# R/package_tests/drift_artifacts.sh, shared with gitpush_with_hooks_safe.sh
	# and test-coverage-R-advanced.yml -- add a generator or a CSV there, never
	# here. (Three private copies drifted apart on 2026-09-07 and the local
	# loop "converged" on output CI's own regeneration disagreed with.)
	mapfile -t drift_csvs < <(bash R/package_tests/drift_artifacts.sh list)
	comprehensive_suite_ok=1
	comprehensive_suite_auto_fixed=0
	max_drift_attempts=5
	attempt=1
	while [ "$attempt" -le "$max_drift_attempts" ]; do
		if bash R/package_tests/drift_artifacts.sh regenerate; then
			:
		else
			comprehensive_suite_ok=0
			break
		fi

		if (cd R && git diff --exit-code -- "${drift_csvs[@]}") >/dev/null 2>&1; then
			break  # clean -- generated CSVs already match what's committed
		fi

		echo "pre-push: generated package_tests/ CSVs drifted from HEAD (attempt $attempt/$max_drift_attempts) -- auto-regenerating and committing the fix ..."
		drift_csvs_prefixed=()
		for f in "${drift_csvs[@]}"; do drift_csvs_prefixed+=("R/$f"); done
		(cd R && git add -- "${drift_csvs[@]}")
		git commit --quiet -m "pre-push: auto-regenerate drifted package_tests CSVs" -- "${drift_csvs_prefixed[@]}"
		comprehensive_suite_auto_fixed=1
		attempt=$((attempt + 1))
	done

	if [ "$comprehensive_suite_auto_fixed" = "1" ]; then
		if (cd R && git diff --exit-code -- "${drift_csvs[@]}") >/dev/null 2>&1; then
			echo "pre-push: auto-regenerated and committed drifted package_tests/ CSVs. Your push now includes stale (pre-fix) commits -- git already resolved which commits to push before this hook ran, so it cannot pick up the new commit on this attempt." >&2
			echo "pre-push: run 'git push' again -- it will include the fix commit and this check will pass immediately." >&2
			abort_push
		else
			echo "pre-push: generated CSVs still drifted after $max_drift_attempts auto-fix attempts. Most likely: other concurrent edits keep landing on the source tree for the whole duration of every attempt -- wait for things to settle and just run 'git push' again. If this keeps happening with no concurrent activity in sight, suspect a non-deterministic generator (different output on consecutive runs against the same unchanged source tree) and fix that script instead of raising this count further." >&2
			(cd R && git diff -- "${drift_csvs[@]}") >&2 || true
			abort_push
		fi
	fi

	# Tracked results only, as in CI: never the local, gitignored
	# comprehensive_tests_results*.csv (see tracked_results_only() in both scripts).
	if [ "$comprehensive_suite_ok" = "1" ] && (
		cd R &&
		export EDI_DRIFT_TRACKED_INPUTS_ONLY=1 &&
		# drift_artifacts.sh just regenerated the internal-surfaces CSV and the
		# generated CSVs match HEAD; the smoke tier reuses it, no second run.
		export EDI_SUITE_INTERNAL_SURFACES_FRESH=1 &&
		Rscript package_tests/run_comprehensive_suite.R smoke "" 300 --force &&
		Rscript package_tests/analyze_comprehensive_suite.R &&
		Rscript package_tests/check_comprehensive_suite_quality_gates.R ci
	); then
		:
	else
		echo "pre-push: comprehensive suite / drift check FAILED." >&2
		echo "pre-push: if this is a drift failure (git diff above), regenerate and commit the affected package_tests/ CSVs -- see R/package_tests/public_argument_combination_runner.md." >&2
		abort_push
	fi
else
	echo "pre-push: no R/package_tests-relevant files changed, skipping comprehensive suite."
fi
}

run_python_block() {
if [ "$run_python_tests" = "1" ]; then
	echo "pre-push: python/C++-relevant files changed -- running edi_kernels test suite ..."
	# This system's python3 is PEP 668 externally-managed, so a bare `pip install`
	# fails outright -- use a persistent venv (created once, reused thereafter)
	# instead of a plain system-wide install.
	py_venv="$repo_root/python/.venv"
	if [ ! -d "$py_venv" ]; then
		python3 -m venv "$py_venv"
	fi
	# Venv-level pip.conf: pip's default ~/.cache/pip is read-only in some
	# contexts pip gets run under (e.g. sandboxed agent sessions), where pip
	# prints a benign "The directory ... is not owned or is not writable ...
	# cache has been disabled" warning on every run. A cache inside the venv is
	# writable anywhere the venv itself is, so the warning goes away and
	# caching still works. Done as $py_venv/pip.conf rather than a
	# PIP_CACHE_DIR prefix on the install below so it covers EVERY invocation
	# of this venv's pip (manual runs included), and (re)written on every hook
	# run so a freshly recreated venv gets it too. Gitignored along with the
	# rest of python/.venv/.
	printf '[global]\ncache-dir = %s\n' "$py_venv/pip-cache" > "$py_venv/pip.conf"
	# Rebuild/reinstall the extension only when what it is built from changed:
	# the C++ kernels (R/EDI/src), the bindings (python/cpp), or the build
	# config (python/CMakeLists.txt, python/pyproject.toml). A push touching only
	# python/src or python/tests runs pytest against the existing editable
	# install, which already picks up pure-Python edits (2026-11-14). A venv
	# without edi_kernels installed (first run, or recreated) installs anyway.
	py_needs_install=0
	if grep -qE '^R/EDI/src/.*\.(cpp|h|hpp)$|^python/cpp/|^python/(CMakeLists\.txt|pyproject\.toml)$' "$changed_files_file" \
		|| ! "$py_venv/bin/python" -c "import edi_kernels, pytest, pytest_cov, scipy" >/dev/null 2>&1; then
		py_needs_install=1
	fi
	if [ "$py_needs_install" = "1" ]; then
		echo "pre-push: C++/bindings/build config changed -- reinstalling edi_kernels ..."
	else
		echo "pre-push: no C++/bindings/build-config changes -- testing the existing edi_kernels install."
	fi
	if ! ( cd python && { [ "$py_needs_install" = "0" ] || "$py_venv/bin/pip" install -q -e ".[test]"; } && "$py_venv/bin/python" -m pytest tests -q --cov=edi_kernels --cov-report=xml ); then
		echo "pre-push: python tests FAILED." >&2
		abort_push
	fi

	echo
	echo "pre-push: checking python coverage against the best-ever baseline ..."
	# Read-only: unlike drift-artifact regeneration above, a local run never
	# writes coverage_baseline.json itself -- only a human bumping it after
	# reviewing a real CI run (see check_coverage_floor.py's own header) is
	# allowed to raise the floor. Runs with the system python3, not the venv
	# above: the script is stdlib-only, same as check_doc_links.py.
	if ! python3 R/package_tests/ci/check_coverage_floor.py python/coverage.xml R/package_tests/ci/coverage_baseline.json python; then
		echo "pre-push: python coverage regressed below the best-ever baseline (see above)." >&2
		abort_push
	fi
else
	echo "pre-push: no python/C++-relevant files changed, skipping python checks."
fi
}

# The R tests (structural gate, full suite), the inference consistency check, the
# comprehensive suite and the python checks share no files: the R suite writes
# only gitignored files under R/EDI/tests, the consistency check only its own
# logs, the comprehensive suite only R/package_tests (and its drift
# auto-commit), the python block only python/ -- so they run at the same time
# (2026-11-14; consistency check split out of the R block 2026-11-15), each into
# its own log, printed whole as each finishes. The first block to fail stops the others and aborts the push, as before.
# EDI_PREPUSH_SERIAL=1 runs them one after another instead, streaming output.
block_log_dir="$(mktemp -d)"
block_names=(r_tests consistency comprehensive_suite python)
block_fns=(run_r_block run_consistency_block run_comprehensive_block run_python_block)

# Background jobs of a non-interactive shell ignore SIGINT, and killing a block's
# subshell leaves its Rscript/pytest children running, so stop whole trees.
kill_tree() {
	local child
	for child in $(pgrep -P "$1" 2>/dev/null || true); do kill_tree "$child"; done
	kill "$1" 2>/dev/null || true
}
declare -A block_pid_of=()
stop_blocks() {
	local pid
	for pid in "${!block_pid_of[@]}"; do kill_tree "$pid"; done
	if [ -n "${block_ticker_pid:-}" ]; then kill_tree "$block_ticker_pid"; fi
}

run_parallel_blocks() {
	local i name pid finished status
	declare -A block_start=()
	for i in "${!block_names[@]}"; do
		name="${block_names[$i]}"
		( "${block_fns[$i]}" ) > "$block_log_dir/$name.log" 2>&1 &
		pid=$!
		block_pid_of[$pid]="$name"
		block_start[$name]=$SECONDS
	done
	trap 'stop_blocks; exit 130' INT TERM
	echo "pre-push: running R tests, consistency check, comprehensive suite and python checks in parallel (logs: $block_log_dir) ..."
	# Heartbeat, since each block's output only appears once it finishes.
	(
		while sleep 60; do
			running=()
			for n in "${block_names[@]}"; do [ -e "$block_log_dir/$n.done" ] || running+=("$n"); done
			[ "${#running[@]}" -gt 0 ] && echo "pre-push: still running after $(( SECONDS / 60 ))m: ${running[*]}"
		done
	) &
	block_ticker_pid=$!

	while [ "${#block_pid_of[@]}" -gt 0 ]; do
		finished=""
		status=0
		wait -n -p finished "${!block_pid_of[@]}" || status=$?
		[ -n "$finished" ] || continue
		name="${block_pid_of[$finished]}"
		unset "block_pid_of[$finished]"
		touch "$block_log_dir/$name.done"
		echo
		echo "===== pre-push: $name $( [ "$status" = 0 ] && echo passed || echo "FAILED (exit $status)" ) after $(( SECONDS - block_start[$name] ))s ====="
		cat "$block_log_dir/$name.log"
		if [ "$status" != 0 ]; then
			if [ "${#block_pid_of[@]}" -gt 0 ]; then
				echo "pre-push: stopping the blocks still running: ${block_pid_of[*]}" >&2
			fi
			stop_blocks
			wait 2>/dev/null || true
			abort_push
		fi
	done
	kill_tree "$block_ticker_pid"
	wait "$block_ticker_pid" 2>/dev/null || true
	trap - INT TERM
	rm -rf "$block_log_dir"
}

if [ "${EDI_PREPUSH_SERIAL:-0}" = "1" ]; then
	run_r_block
	echo
	run_consistency_block
	echo
	run_comprehensive_block
	echo
	run_python_block
	rm -rf "$block_log_dir"
else
	run_parallel_blocks
fi

echo "pre-push: all local checks passed."
exit 0
